{
  "name": "DarkTheme",
  "type": "theme",
  "framework": "pure-css",
  "description": "Тёмная тема: переопределяет цвета фона, текста, границ и тени.",
  "scopeSelector": "[data-theme=\"dark\"]",
  "overrides": {
    "colors": {
      "tokens": {
        "--color-bg": "#141311",
        "--color-surface": "#1f1d1a",
        "--color-text": "#edeae5",
        "--color-primary": "#f26a3e",
        "--color-accent": "#ff865f",
        "--color-text-muted": "#9e9a94",
        "--color-border": "#3d3935"
      }
    }
  }
}
