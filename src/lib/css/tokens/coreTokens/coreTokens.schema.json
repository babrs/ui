      "tokens": {
        "--radius-lg": { "value": "24px", "type": "dimension", "description": "Карточки и окна" },
        "--radius-pill": { "value": "999px", "type": "dimension", "description": "Кнопки и бейджи" }
      }
    },
    "typography": {
      "description": "Шрифты, размеры и начертания",
      "tokens": {
        "--font-primary": { "value": "'DM Sans', system-ui, sans-serif", "type": "font-family", "description": "Основной текст" },
        "--font-display": { "value": "'Unbounded', system-ui, sans-serif", "type": "font-family", "description": "Заголовки" },
