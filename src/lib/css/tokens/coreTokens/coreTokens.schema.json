        "--color-text": { "value": "#2d2a26", "type": "color", "description": "Основной текст" },
        "--color-bg": { "value": "#fdf8f4", "type": "color", "description": "Фон страницы" },
        "--color-surface": { "value": "#ffffff", "type": "color", "description": "Фон карточек и окон" },
        "--color-border": { "value": "#e8dfd5", "type": "color", "description": "Границы карточек и разделителей" },
