{
  "name": "ButtonGroup",
  "type": "component",
  "svelteVersion": 5,
  "description": "Группа кнопок: с общими границами или растянутая по ширине контейнера.",
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": false,
      "description": "Доступное имя группы"
    },
    {
      "name": "attached",
      "type": "boolean",
      "required": false,
      "defaultValue": true,
      "description": "Склеить кнопки в один блок"
    },
    {
      "name": "grow",
      "type": "boolean",
      "required": false,
      "defaultValue": false,
      "description": "Растянуть группу на всю ширину, кнопки делят место поровну"
    },
    {
      "name": "children",
      "type": "import('svelte').Snippet",
      "required": true,
      "description": "Кнопки группы"
    }
  ]
}