{
  "name": "HeroBanner",
  "type": "component",
  "svelteVersion": 5,
  "description": "Вступительный баннер с фоновым изображением, заголовком или картинкой-заголовком и дополнительным содержимым.",
  "props": [
    { "name": "backgroundImage", "type": "string", "required": false, "defaultValue": "", "description": "Адрес фонового изображения" },
    { "name": "title", "type": "string", "required": true, "description": "Заголовок баннера (остаётся для программ чтения экрана при использовании titleImage)" },
    { "name": "titleImage", "type": "string", "required": false, "defaultValue": "", "description": "Изображение вместо видимого заголовка" },
    { "name": "titleAlt", "type": "string", "required": false, "defaultValue": "", "description": "Альтернативный текст изображения заголовка" },
    { "name": "children", "type": "Snippet", "required": false, "isSnippet": true, "arguments": [], "description": "Дополнительное содержимое под заголовком" }
  ]
}
