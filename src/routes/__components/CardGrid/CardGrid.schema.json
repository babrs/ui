{
  "name": "CardGrid",
  "type": "component",
  "svelteVersion": 5,
  "description": "Адаптивная сетка карточек: каждый элемент открывается по нажатию и отдаётся в сниппет item.",
  "props": [
    { "name": "items", "type": "Array<{ id?: string | number }>", "required": true, "description": "Элементы сетки" },
    { "name": "label", "type": "string", "required": true, "description": "Название сетки для вспомогательных технологий" },
    { "name": "onopen", "type": "function", "required": false, "isEvent": true, "arguments": [{ "name": "index", "type": "number", "description": "Индекс выбранного элемента" }], "description": "Вызывается при выборе элемента" },
    { "name": "item", "type": "Snippet<[any, number]>", "required": true, "isSnippet": true, "arguments": [{ "name": "entry", "type": "any", "description": "Элемент сетки" }, { "name": "index", "type": "number", "description": "Индекс элемента" }], "description": "Оформление одного элемента" }
  ]
}
