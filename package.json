{
	"name": "babrs-ui",
	"version": "0.5.0",
	"description": "Babrs UI: атомарные компоненты Svelte 5, дизайн-токены и CSS для проектов Babrs",
	"type": "module",
	"svelte": "./dist/index.js",
	"main": "./dist/index.js",
	"files": ["dist"],
	"sideEffects": ["**/*.css"],
	"exports": {
		".": {
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles": "./dist/css/index.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-package -i src/lib -o dist",
		"prepare": "npm run package"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.58.0",
		"vite": "^8.3.8"
	}
}
