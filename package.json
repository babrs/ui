{
  "name": "babrs-ui",
  "version": "0.1.0",
  "description": "Babrs UI: атомарные Svelte 5 компоненты, дизайн-токены и CSS",
  "type": "module",
  "main": "./dist/index.js",
  "svelte": "./dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./dist/styles/index.css"
  },
  "scripts": {
    "package": "svelte-package -i src/lib -o dist",
    "prepare": "npm run package"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "svelte": "^5.0.0"
  }
}
